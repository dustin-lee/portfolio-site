# ---- Public site builds fine with NONE of these set (it uses content.snapshot.json) ----

# Supabase (needed for /studio to persist, and for CI to read the published config)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Only this Supabase user id may open /studio or write config
STUDIO_OWNER_ID=

# GitHub sync (fine-grained PAT, public repo read only)
GH_READ_TOKEN=
GITHUB_USERNAME=

# Netlify build hook fired on Publish
NETLIFY_BUILD_HOOK=
